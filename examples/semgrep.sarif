{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep",
          "rules": [
            {
              "id": "python.lang.security.audit.formatted-sql-query.formatted-sql-query",
              "shortDescription": {
                "text": "SQL query built with string formatting"
              },
              "help": {
                "text": "Use parameterized queries: pass user input as parameters, never format it into the SQL string."
              },
              "properties": {
                "security-severity": "8.1",
                "tags": [
                  "CWE-89: Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')",
                  "OWASP-A03:2021"
                ]
              }
            },
            {
              "id": "rules.raw-html-rendering",
              "shortDescription": {
                "text": "User content rendered into HTML without escaping"
              },
              "help": {
                "text": "Escape user content with html.escape() or use an auto-escaping template engine."
              },
              "properties": {
                "tags": [
                  "CWE-79: Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')"
                ]
              }
            },
            {
              "id": "python.jwt.security.jwt-hardcode.jwt-python-hardcoded-secret",
              "shortDescription": {
                "text": "Hardcoded JWT secret"
              },
              "help": {
                "text": "Load the signing secret from an environment variable or secret manager."
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "CWE-798: Use of Hard-coded Credentials"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "python.lang.security.audit.formatted-sql-query.formatted-sql-query",
          "level": "error",
          "message": {
            "text": "Detected SQL statement built with an f-string. This could lead to SQL injection."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/main.py"
                },
                "region": {
                  "startLine": 80
                }
              }
            }
          ]
        },
        {
          "ruleId": "rules.raw-html-rendering",
          "level": "warning",
          "message": {
            "text": "Review text is returned without HTML escaping."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/main.py"
                },
                "region": {
                  "startLine": 140
                }
              }
            }
          ]
        },
        {
          "ruleId": "python.jwt.security.jwt-hardcode.jwt-python-hardcoded-secret",
          "level": "error",
          "message": {
            "text": "Hardcoded JWT secret detected."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/config.py"
                },
                "region": {
                  "startLine": 17
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
