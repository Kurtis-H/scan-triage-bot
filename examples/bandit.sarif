  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Bandit",
          "rules": [
            {
              "id": "B608",
              "shortDescription": {
                "text": "Possible SQL injection via string-based query construction"
              },
              "help": {
                "text": "Use parameterized queries."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-89"
                ]
              }
            },
            {
              "id": "B101",
              "shortDescription": {
                "text": "Use of assert detected"
              },
              "help": {
                "text": "Asserts are removed when Python runs with -O; don't use them for runtime checks."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-703"
                ]
              }
            }
          ]
        }
      },
      "results": [
